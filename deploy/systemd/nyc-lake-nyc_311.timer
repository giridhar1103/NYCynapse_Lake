[Unit]
Description=Schedule for NYCynapse lake load: nyc_311

[Timer]
OnCalendar=*-*-* 03:15:00 UTC
# Again before the daily tables at 10:00: the copies that answer queries can be hours behind.
OnCalendar=*-*-* 09:15:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=nyc-lake@nyc_311.service

[Install]
WantedBy=timers.target
