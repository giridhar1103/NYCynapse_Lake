[Unit]
Description=NYCynapse lake maintenance
After=postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/root/NYCynapse_Lake
EnvironmentFile=/root/.secrets/nycynapse.env
Environment=HOME=/root
ExecStart=/root/NYCynapse_Lake/.venv/bin/nyc-lake maintain
MemoryMax=2G
Nice=15
TimeoutStartSec=3h
Restart=on-failure
RestartSec=20min
RestartSteps=3
RestartMaxDelaySec=2h
