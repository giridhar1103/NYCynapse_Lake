[Unit]
Description=NYCynapse lake load: %i
After=network-online.target postgresql.service
Wants=network-online.target
# Starts by timer count as starts too, so a start limit would block jobs that run often.
StartLimitIntervalSec=0

[Service]
Type=oneshot
WorkingDirectory=/root/NYCynapse_Lake
EnvironmentFile=/root/.secrets/nycynapse.env
Environment=HOME=/root
ExecStart=/root/NYCynapse_Lake/.venv/bin/nyc-lake run %i
# 75 means the source was busy or its circuit breaker is open. Not a failure.
SuccessExitStatus=75
# A load that fails tries again after 20 minutes, then less and less often. 65 means the data
# itself was refused, which trying again will not change.
Restart=on-failure
RestartSec=20min
RestartSteps=4
RestartMaxDelaySec=4h
RestartPreventExitStatus=65
MemoryMax=1536M
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
