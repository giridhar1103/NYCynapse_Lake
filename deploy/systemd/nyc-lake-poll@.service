[Unit]
Description=NYCynapse live poller: %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/NYCynapse_Lake
EnvironmentFile=/root/.secrets/nycynapse.env
Environment=HOME=/root
ExecStart=/root/NYCynapse_Lake/.venv/bin/nyc-lake poll %i
Restart=always
RestartSec=15
# The poller writes what it holds on SIGTERM before it exits.
TimeoutStopSec=120
# Memory climbs slowly and reached the cap every day or two. A planned restart saves what is held;
# a kill at the cap does not.
RuntimeMaxSec=20h
RuntimeRandomizedExtraSec=2h
MemoryMax=768M
Nice=5

[Install]
WantedBy=multi-user.target
