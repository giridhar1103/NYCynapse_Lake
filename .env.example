# Postgres holds both the DuckLake catalog and the ops control tables.
NYC_LAKE_PG_DSN="dbname=nycynapse_lake host=127.0.0.1 user=nyc_lake password=change-me"
NYC_LAKE_DATA_PATH=/srv/nycynapse/lake
NYC_LAKE_TMP_PATH=/srv/nycynapse/tmp
NYC_LAKE_SPOOL_PATH=/srv/nycynapse/spool
NYC_LAKE_MEMORY_LIMIT=1GB
NYC_LAKE_THREADS=2
# Optional, raises Socrata rate limits
SOCRATA_APP_TOKEN=
